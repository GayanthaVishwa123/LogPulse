version: '3.8'

services:
  auth-service:
    volumes:
      - ./services/auth-service:/app
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

  processor-service:
    volumes:
      - ./services/processor-service:/app
    command: uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload

  celery-worker:
    volumes:
      - ./services/processor-service:/app